from services.book_service import BookService
from repositories import BookRepository

def test_create_book():
    service = BookService(BookRepository())
    book = service.create_book("1984", "George Orwell")
    assert book.title == "1984"
    assert book.author == "George Orwell"

def test_checkout_book():
    repo = BookRepository()
    service = BookService(repo)
    book = service.create_book("Dune", "Frank Herbert")
    checked_out_book = service.checkout_book(book.id)
    assert checked_out_book.checked_out is True


from services.user_service import UserService
from repositories import UserRepository

def test_create_user():
    service = UserService(UserRepository())
    user = service.create_user("Alice")
    assert user.name == "Alice"
